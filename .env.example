# ========================================
# ATTENDANCE CONFIGURATION
# ========================================

# Maximum allowed GPS accuracy in meters (default: 300)
ATTENDANCE_MAX_ACCURACY=300

# Auto-select nearest location within this radius in meters (default: 500)
ATTENDANCE_AUTO_SELECT_RADIUS=500

# TIME WINDOW VALIDATIONS
# Maximum hours BEFORE shift start that check-in is allowed (default: 2)
ATTENDANCE_CHECKIN_WINDOW_BEFORE=2

# Maximum hours AFTER shift end that check-out is allowed (default: 4)
ATTENDANCE_CHECKOUT_WINDOW_AFTER=4

# Grace period for early check-in in minutes (default: 30)
ATTENDANCE_EARLY_CHECKIN_GRACE=30

# Enable strict time window enforcement (RECOMMENDED: true for production)
# If true: violations will BLOCK check-in/out with error message
# If false: violations will only LOG warnings but allow the action
ATTENDANCE_STRICT_TIME_WINDOW=true
