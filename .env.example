DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simpegrshdi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========================================
# ATTENDANCE CONFIGURATION
# ========================================

# Maximum allowed GPS accuracy in meters (default: 300)
# If GPS accuracy is worse than this, check-in will be rejected
ATTENDANCE_MAX_ACCURACY=300

# Auto-select nearest location within this radius in meters (default: 500)
ATTENDANCE_AUTO_SELECT_RADIUS=500

# TIME WINDOW VALIDATIONS
# Maximum hours BEFORE shift start that check-in is allowed (default: 2)
# Example: Shift starts at 08:00, with value 2, earliest check-in is 06:00
ATTENDANCE_CHECKIN_WINDOW_BEFORE=2

# Maximum hours AFTER shift end that check-out is allowed (default: 4)
# Example: Shift ends at 14:30, with value 4, latest check-out is 18:30
ATTENDANCE_CHECKOUT_WINDOW_AFTER=4

# Grace period for early check-in in minutes (default: 30)
# Employees can check-in this many minutes earlier than the window without strict rejection
ATTENDANCE_EARLY_CHECKIN_GRACE=30

# Enable strict time window enforcement (default: false)
# If true: violations will BLOCK check-in/out with error message
# If false: violations will only LOG warnings but allow the action
# RECOMMENDED: Set to TRUE for production to prevent abuse
ATTENDANCE_STRICT_TIME_WINDOW=true

# SHIFT SWAP SETTINGS
SHIFT_SWAP_MIN_REST_HOURS=12
SHIFT_SWAP_LEAD_TIME_HOURS=48
SHIFT_SWAP_CRITICAL_LEAD_TIME_HOURS=72
SHIFT_SWAP_MIN_STAFFING_PCT=75
SHIFT_SWAP_EXPIRATION_HOURS=72
