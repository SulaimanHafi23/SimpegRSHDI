---
config:
  layout: elk
---

erDiagram
    %% ===== MASTER =====
    religions {
        uuid id PK
        string name
        boolean is_active
    }

    genders {
        uuid id PK
        string name
        boolean is_active
    }

    departments {
        uuid id PK
        string name
        string code
        uuid parent_id FK
        uuid manager_id FK
        boolean requires_holiday_attendance
        boolean is_active
    }

    locations {
        uuid id PK
        string name
        decimal latitude
        decimal longitude
        integer radius
        boolean enforce_geofence
        boolean is_active
    }

    document_types {
        uuid id PK
        string name
        string file_format
        bigint max_file_size
        boolean is_universal
        boolean is_active
    }

    holidays {
        uuid id PK
        date date
        string name
        boolean is_national
    }

    %% ===== WORKFORCE & AUTH =====
    workers {
        uuid id PK
        string nip UK
        string name
        string email UK
        string phone_number UK
        uuid gender_id FK
        uuid religion_id FK
        uuid department_id FK
        date hire_date
        date resign_date
        enum employment_status
        enum status
        timestamp deleted_at
    }

    users {
        uuid id PK
        uuid worker_id FK
        string email UK
        string username UK
        timestamp last_login
        boolean is_active
    }

    %% ===== SPATIE RBAC =====
    permissions {
        bigint id PK
        string name
        string guard_name
    }

    roles {
        bigint id PK
        string name
        string guard_name
    }

    model_has_permissions {
        bigint permission_id FK
        uuid model_id
        string model_type
    }

    model_has_roles {
        bigint role_id FK
        uuid model_id
        string model_type
    }

    role_has_permissions {
        bigint permission_id FK
        bigint role_id FK
    }

    %% ===== SCHEDULING =====
    shifts {
        uuid id PK
        string name
        time start_time
        time end_time
        decimal total_hours
        integer grace_period_minutes
        boolean is_overnight
        boolean is_active
    }

    shift_day_times {
        uuid id PK
        uuid shift_id FK
        tinyint day_of_week
        time start_time
        time end_time
    }

    worker_shifts {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        date effective_from
        date effective_until
        boolean is_active
        text notes
    }

    worker_shift_histories {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        uuid changed_by FK
        date effective_from
        date effective_until
        timestamp changed_at
    }

    shift_overrides {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        date override_date
        uuid created_by FK
    }

    worker_off_days {
        uuid id PK
        uuid worker_id FK
        json day_of_week
        date effective_from
        date effective_until
        uuid created_by
    }

    worker_off_day_exceptions {
        uuid id PK
        uuid worker_id FK
        date off_date
        enum type
        json recurring_pattern
        uuid created_by
    }

    %% ===== ATTENDANCE =====
    attendances {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        uuid location_id FK
        date attendance_date
        datetime check_in
        datetime check_out
        enum status
        boolean check_in_by_admin
        uuid check_in_admin_id FK
        boolean check_out_by_admin
        uuid check_out_admin_id FK
        boolean is_late
        integer late_minutes
        boolean is_early_leave
        integer early_leave_minutes
    }

    attendance_photos {
        uuid id PK
        uuid attendance_id FK
        string photo_path
        enum photo_type
        timestamp taken_at
    }

    %% ===== LEAVE / OVERTIME / TRIP =====
    leave_types {
        uuid id PK
        string name
        string code UK
        integer max_days_per_year
        boolean requires_approval
        boolean requires_attachment
        integer days_notice
        boolean is_active
    }

    leave_requests {
        uuid id PK
        uuid worker_id FK
        uuid leave_type_id FK
        date start_date
        date end_date
        integer total_days
        enum status
        uuid approved_by FK
        timestamp approved_at
    }

    overtime_requests {
        uuid id PK
        uuid worker_id FK
        date overtime_date
        time start_time
        time end_time
        integer total_hours
        enum status
        uuid approved_by FK
        timestamp approved_at
    }

    business_trips {
        uuid id PK
        uuid worker_id FK
        date start_date
        date end_date
        enum status
        uuid approved_by FK
        json itinerary
    }

    salary_components {
        uuid id PK
        string code UK
        string name
        enum type
        boolean is_taxable
        boolean is_active
        timestamp deleted_at
    }

    %% ===== DOCUMENTS =====
    department_document_type {
        uuid id PK
        uuid department_id FK
        uuid document_type_id FK
    }

    worker_documents {
        uuid id PK
        uuid worker_id FK
        uuid document_type_id FK
        uuid department_document_type_id FK
        bigint file_size
        date expired_date
        enum status
        uuid verified_by FK
        timestamp verified_at
    }

    %% ===== SHIFT SWAP =====
    shift_swap_requests {
        uuid id PK
        uuid requester_id FK
        uuid target_worker_id FK
        uuid requester_shift_id FK
        uuid target_shift_id FK
        string swap_type
        date swap_date
        date swap_start_date
        date swap_end_date
        json swap_dates
        enum status
        uuid manager_id FK
        uuid executed_by FK
        timestamp requested_at
        timestamp expires_at
        timestamp executed_at
        timestamp deleted_at
    }

    shift_swap_audit_logs {
        uuid id PK
        uuid shift_swap_request_id FK
        uuid user_id FK
        string action
        string old_status
        string new_status
    }

    shift_swap_overrides {
        bigint id PK
        timestamp created_at
        timestamp updated_at
    }

    %% ===== RELATIONSHIPS =====
    genders ||--o{ workers : has
    religions ||--o{ workers : has
    departments ||--o{ workers : has
    departments ||--o{ departments : parent
    users ||--o{ departments : manager

    workers ||--|| users : account

    permissions ||--o{ model_has_permissions : map
    roles ||--o{ model_has_roles : map
    permissions ||--o{ role_has_permissions : map
    roles ||--o{ role_has_permissions : map

    shifts ||--o{ shift_day_times : daily_time
    workers ||--o{ worker_shifts : assigned
    shifts ||--o{ worker_shifts : assigned
    workers ||--o{ worker_shift_histories : history
    shifts ||--o{ worker_shift_histories : history
    users ||--o{ worker_shift_histories : changed_by
    workers ||--o{ shift_overrides : override
    shifts ||--o{ shift_overrides : override
    users ||--o{ shift_overrides : created_by
    workers ||--o{ worker_off_days : off_day
    workers ||--o{ worker_off_day_exceptions : off_day_exception

    workers ||--o{ attendances : records
    shifts ||--o{ attendances : shift
    locations ||--o{ attendances : location
    users ||--o{ attendances : admin_action
    attendances ||--o{ attendance_photos : photos

    leave_types ||--o{ leave_requests : type
    workers ||--o{ leave_requests : requester
    users ||--o{ leave_requests : approver

    workers ||--o{ overtime_requests : requester
    users ||--o{ overtime_requests : approver

    workers ||--o{ business_trips : requester
    users ||--o{ business_trips : approver

    departments ||--o{ department_document_type : rule
    document_types ||--o{ department_document_type : rule
    workers ||--o{ worker_documents : owner
    document_types ||--o{ worker_documents : type
    department_document_type ||--o{ worker_documents : requirement
    users ||--o{ worker_documents : verifier

    workers ||--o{ shift_swap_requests : requester_target
    worker_shifts ||--o{ shift_swap_requests : shift_ref
    users ||--o{ shift_swap_requests : manager_executor
    shift_swap_requests ||--o{ shift_swap_audit_logs : logs
    users ||--o{ shift_swap_audit_logs : actor
