---
config:
  layout: elk
---

erDiagram
    %% ===== DATA MASTER =====
    religions {
        uuid id PK
        string name
        boolean is_active
    }

    genders {
        uuid id PK
        string name
        boolean is_active
    }

    departments {
        uuid id PK
        string name
        string code
        text description
        uuid parent_id FK
        uuid manager_id FK
        boolean requires_holiday_attendance
        boolean is_active
    }

    document_types {
        uuid id PK
        string name
        text description
        string file_format
        integer max_file_size
        boolean is_universal
        boolean is_active
    }

    holidays {
        uuid id PK
        date date
        string name
        text description
        boolean is_national
    }

    salary_components {
        uuid id PK
        string code UK
        string name
        enum type
        text description
        boolean is_taxable
        boolean is_active
        timestamp deleted_at
    }

    %% ===== PEGAWAI & AUTENTIKASI =====
    workers {
        uuid id PK
        string nip UK
        string name
        string email UK
        string phone_number UK
        text address
        date birth_date
        string birth_place
        enum gender
        enum religion
        uuid department_id FK
        date hire_date
        date resign_date
        enum employment_status
        enum status
        string photo_url
        timestamp deleted_at
    }

    users {
        uuid id PK
        uuid worker_id FK
        string email UK
        string username UK
        string password
        timestamp last_login
        boolean is_active
        timestamp deleted_at
    }

    %% ===== HAK AKSES (SPATIE RBAC) =====
    permissions {
        bigint id PK
        string name
        string guard_name
    }

    roles {
        bigint id PK
        string name
        string guard_name
    }

    model_has_permissions {
        bigint permission_id FK
        uuid model_id
        string model_type
    }

    model_has_roles {
        bigint role_id FK
        uuid model_id
        string model_type
    }

    role_has_permissions {
        bigint permission_id FK
        bigint role_id FK
    }

    %% ===== PENJADWALAN =====
    shifts {
        uuid id PK
        string name
        time start_time
        time end_time
        decimal total_hours
        integer grace_period_minutes
        boolean is_overnight
        boolean is_active
    }

    shift_day_times {
        uuid id PK
        uuid shift_id FK
        tinyint day_of_week
        time start_time
        time end_time
    }

    worker_shifts {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        date effective_from
        date effective_until
        boolean is_active
        text notes
    }

    worker_shift_histories {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        uuid changed_by FK
        date effective_from
        date effective_until
        date changed_at
        string change_reason
        text notes
    }

    shift_overrides {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        date override_date
        text reason
        uuid created_by FK
        uuid shift_swap_request_id FK
    }

    worker_off_days {
        uuid id PK
        uuid worker_id FK
        json day_of_week
        date effective_from
        date effective_until
        string reason
        uuid created_by
    }

    %% ===== ABSENSI =====
    attendances {
        uuid id PK
        uuid worker_id FK
        uuid shift_id FK
        date attendance_date
        datetime check_in
        decimal check_in_latitude
        decimal check_in_longitude
        integer distance_check_in
        boolean check_in_by_admin
        uuid check_in_admin_id FK
        datetime check_out
        decimal check_out_latitude
        decimal check_out_longitude
        integer distance_check_out
        boolean check_out_by_admin
        uuid check_out_admin_id FK
        enum status
        boolean is_late
        integer late_minutes
        boolean is_early_leave
        integer early_leave_minutes
        boolean is_outside_radius
        integer overtime_minutes
        text notes
        timestamp deleted_at
    }

    attendance_photos {
        uuid id PK
        uuid attendance_id FK
        string photo_path
        enum photo_type
        timestamp taken_at
    }

    %% ===== CUTI / LEMBUR / PERJALANAN DINAS =====
    leave_types {
        uuid id PK
        string name
        string code UK
        integer max_days_per_year
        boolean requires_approval
        boolean requires_attachment
        integer days_notice
        boolean is_active
    }

    leave_requests {
        uuid id PK
        uuid worker_id FK
        uuid leave_type_id FK
        date start_date
        date end_date
        integer total_days
        text reason
        string attachment_path
        enum status
        uuid approved_by FK
        timestamp approved_at
        text rejection_reason
        timestamp deleted_at
    }

    overtime_requests {
        uuid id PK
        uuid worker_id FK
        date overtime_date
        time start_time
        time end_time
        decimal total_hours
        text reason
        enum status
        uuid approved_by FK
        timestamp approved_at
        text rejection_reason
        timestamp deleted_at
    }

    business_trips {
        uuid id PK
        uuid worker_id FK
        string destination
        text purpose
        date start_date
        date end_date
        string trip_duration_type
        string half_day_session
        string transportation
        string accommodation
        text notes
        decimal estimated_cost
        enum status
        uuid approved_by FK
        timestamp approved_at
        text rejection_reason
        json itinerary
        timestamp deleted_at
    }

    %% ===== DOKUMEN =====
    department_document_type {
        uuid id PK
        uuid department_id FK
        uuid document_type_id FK
    }

    worker_documents {
        uuid id PK
        uuid worker_id FK
        uuid document_type_id FK
        uuid department_document_type_id FK
        string file_name
        string file_path
        bigint file_size
        date expired_date
        enum status
        uuid verified_by FK
        timestamp verified_at
        text notes
        timestamp deleted_at
    }

    %% ===== TUKAR SHIFT =====
    shift_swap_requests {
        uuid id PK
        uuid requester_id FK
        uuid target_worker_id FK
        uuid requester_shift_id FK
        uuid target_shift_id FK
        string swap_type
        date swap_start_date
        date swap_end_date
        json swap_dates
        enum status
        boolean requires_manager_approval
        uuid manager_id FK
        timestamp manager_approved_at
        text reason
        json metadata
        uuid executed_by FK
        timestamp requested_at
        timestamp executed_at
        timestamp deleted_at
    }

    shift_swap_audit_logs {
        uuid id PK
        uuid shift_swap_request_id FK
        uuid user_id FK
        string action
        string old_status
        string new_status
        text notes
        json metadata
        string ip_address
        string user_agent
    }

    shift_swap_overrides {
        bigint id PK
        timestamp created_at
        timestamp updated_at
    }

    %% ===== SISTEM =====
    audit_logs {
        uuid id PK
        uuid user_id FK
        string user_name
        string action
        string auditable_type
        uuid auditable_id
        string description
        json old_values
        json new_values
        string ip_address
        text user_agent
        string url
    }

    %% ===== RELASI =====
    departments ||--o{ workers : memiliki
    departments o|--o{ departments : induk
    users o|--o{ departments : manajer

    workers o|--|| users : akun

    permissions ||--o{ model_has_permissions : pemetaan
    roles ||--o{ model_has_roles : pemetaan
    permissions ||--o{ role_has_permissions : pemetaan
    roles ||--o{ role_has_permissions : pemetaan

    shifts ||--o{ shift_day_times : jadwal_harian
    workers ||--o{ worker_shifts : penugasan
    shifts o|--o{ worker_shifts : penugasan
    workers ||--o{ worker_shift_histories : riwayat
    shifts ||--o{ worker_shift_histories : riwayat
    users o|--o{ worker_shift_histories : pengubah
    workers ||--o{ shift_overrides : override
    shifts ||--o{ shift_overrides : override
    users ||--o{ shift_overrides : dibuat_oleh
    shift_swap_requests o|--o{ shift_overrides : sumber
    workers ||--o{ worker_off_days : hari_libur

    workers ||--o{ attendances : rekaman
    shifts o|--o{ attendances : shift
    users o|--o{ attendances : admin_masuk
    users o|--o{ attendances : admin_keluar
    attendances ||--o{ attendance_photos : foto

    leave_types ||--o{ leave_requests : jenis
    workers ||--o{ leave_requests : pemohon
    users o|--o{ leave_requests : penyetuju

    workers ||--o{ overtime_requests : pemohon
    users o|--o{ overtime_requests : penyetuju

    workers ||--o{ business_trips : pemohon
    users o|--o{ business_trips : penyetuju

    departments ||--o{ department_document_type : aturan
    document_types ||--o{ department_document_type : aturan
    workers ||--o{ worker_documents : pemilik
    document_types ||--o{ worker_documents : jenis
    department_document_type o|--o{ worker_documents : persyaratan
    users o|--o{ worker_documents : verifikator

    workers ||--o{ shift_swap_requests : pemohon
    workers o|--o{ shift_swap_requests : target
    worker_shifts ||--o{ shift_swap_requests : shift_pemohon
    worker_shifts o|--o{ shift_swap_requests : shift_target
    users o|--o{ shift_swap_requests : manajer
    users o|--o{ shift_swap_requests : eksekutor
    shift_swap_requests ||--o{ shift_swap_audit_logs : log
    users o|--o{ shift_swap_audit_logs : aktor
    users o|--o{ audit_logs : aktor
