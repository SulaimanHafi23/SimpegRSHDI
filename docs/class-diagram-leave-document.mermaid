classDiagram
direction LR

class Worker {
  +nip
  +name
  +department_id
  +status
  +leaveRequests()
  +workerDocuments()
}

class LeaveRequest {
  +worker_id
  +leave_type_id
  +start_date
  +end_date
  +total_days
  +reason
  +attachment_path
  +status
  +approved_by
  +approved_at
  +rejection_reason
  +worker()
  +leaveType()
  +approver()
}

class LeaveType {
  +name
  +code
  +max_days_per_year
  +requires_approval
  +requires_attachment
  +days_notice
  +is_active
  +leaveRequests()
}

class WorkerDocument {
  +worker_id
  +document_type_id
  +department_document_type_id
  +file_name
  +file_path
  +file_size
  +expired_date
  +status
  +verified_by
  +verified_at
  +notes
  +worker()
  +documentType()
  +departmentDocumentType()
  +verifier()
  +isExpired()
}

class DocumentType {
  +name
  +description
  +file_format
  +max_file_size
  +is_required
  +is_universal
  +is_active
  +workerDocuments()
  +departments()
}

class DepartmentDocumentType {
  +department_id
  +document_type_id
  +department()
  +documentType()
}

class BusinessTrip {
  +worker_id
  +destination
  +purpose
  +start_date
  +end_date
  +status
  +approved_by
  +approved_at
  +rejection_reason
  +worker()
  +approvedBy()
}

class LeaveRequestController {
  +index()
  +create()
  +store()
  +show()
  +approve()
  +reject()
  +cancel()
  +destroy()
  +export()
  +workerLeaveBalance()
}

class LeaveApprovalController {
  +index()
  +show()
  +approve()
  +reject()
}

class WorkerDocumentController {
  +index()
  +create()
  +store()
  +show()
  +verify()
  +reject()
  +download()
  +expired()
  +expiring()
}

class DocumentApprovalController {
  +index()
  +show()
  +verify()
  +reject()
}

class BusinessTripController {
  +index()
  +create()
  +store()
  +show()
  +cancel()
  +export()
}

class BusinessTripApprovalController {
  +index()
  +show()
  +approve()
  +reject()
  +destroy()
  +export()
}

LeaveRequest --> Worker : belongsTo
LeaveRequest --> LeaveType : belongsTo
LeaveType --> "*" LeaveRequest : hasMany
WorkerDocument --> Worker : belongsTo
WorkerDocument --> DocumentType : belongsTo
WorkerDocument --> DepartmentDocumentType : belongsTo
DocumentType --> "*" WorkerDocument : hasMany
DocumentType --> DepartmentDocumentType : belongsToMany
DepartmentDocumentType --> DocumentType : belongsTo
DepartmentDocumentType --> Department : belongsTo
BusinessTrip --> Worker : belongsTo
Worker --> "*" LeaveRequest : hasMany
Worker --> "*" WorkerDocument : hasMany
Worker --> "*" BusinessTrip : hasMany
LeaveRequestController ..> LeaveRequest : uses
LeaveRequestController ..> LeaveType : uses
LeaveApprovalController ..> LeaveRequest : uses
WorkerDocumentController ..> WorkerDocument : uses
WorkerDocumentController ..> DocumentType : uses
DocumentApprovalController ..> WorkerDocument : uses
BusinessTripController ..> BusinessTrip : uses
BusinessTripApprovalController ..> BusinessTrip : uses
BusinessTripApprovalController ..> Worker : uses
