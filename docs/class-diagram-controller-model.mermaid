%% MODEL RELATIONSHIPS
M_Attendance --> M_Worker : belongsTo
M_Attendance --> M_Shift : belongsTo
M_Attendance --> M_User : belongsTo
M_Attendance --> "*" M_AttendancePhoto : hasMany
M_AttendancePhoto --> M_Attendance : belongsTo
M_AuditLog --> M_User : belongsTo
M_BusinessTrip --> M_Worker : belongsTo
M_BusinessTrip --> M_User : belongsTo
M_Department --> "*" M_Worker : hasMany
M_Department --> M_Department : belongsTo
M_Department --> "*" M_Department : hasMany
M_Department --> M_User : belongsTo
M_DepartmentDocumentType --> M_Department : belongsTo
M_DepartmentDocumentType --> M_DocumentType : belongsTo
M_DocumentType --> "*" M_WorkerDocument : hasMany
M_DocumentType "*" --> "*" M_Department : belongsToMany
M_LeaveRequest --> M_Worker : belongsTo
M_LeaveRequest --> M_LeaveType : belongsTo
M_LeaveRequest --> M_User : belongsTo
M_LeaveType --> "*" M_LeaveRequest : hasMany
M_Notification --> M_User : belongsTo
M_Shift --> "*" M_WorkerShift : hasMany
M_Shift --> "*" M_ShiftDayTime : hasMany
M_Shift --> "*" M_ShiftOverride : hasMany
M_Shift --> "*" M_Attendance : hasMany
M_ShiftDayTime --> M_Shift : belongsTo
M_ShiftOverride --> M_Worker : belongsTo
M_ShiftOverride --> M_Shift : belongsTo
M_ShiftOverride --> M_User : belongsTo
M_ShiftOverride --> M_ShiftSwapRequest : belongsTo
M_ShiftSwapAuditLog --> M_ShiftSwapRequest : belongsTo
M_ShiftSwapAuditLog --> M_User : belongsTo
M_ShiftSwapRequest --> M_Worker : belongsTo
M_ShiftSwapRequest --> M_WorkerShift : belongsTo
M_ShiftSwapRequest --> M_User : belongsTo
M_ShiftSwapRequest --> "*" M_ShiftSwapAuditLog : hasMany
M_User --> M_Worker : belongsTo
M_User --> "*" M_ShiftOverride : hasMany
M_User --> "*" M_WorkerDocument : hasMany
M_User --> "*" M_LeaveRequest : hasMany
M_Worker --> M_Department : belongsTo
M_Worker --> M_Shift : belongsTo
M_Worker --> M_User : hasOne
M_Worker --> "*" M_WorkerShift : hasMany
M_Worker --> "*" M_ShiftOverride : hasMany
M_Worker --> "*" M_WorkerShiftHistory : hasMany
M_Worker --> "*" M_Attendance : hasMany
M_Worker --> "*" M_WorkerDocument : hasMany
M_Worker --> "*" M_LeaveRequest : hasMany
M_Worker --> "*" M_ShiftSwapRequest : hasMany
M_Worker --> "*" M_WorkerOffDay : hasMany
M_Worker --> M_WorkerShift : hasOne
M_WorkerDocument --> M_Worker : belongsTo
M_WorkerDocument --> M_DocumentType : belongsTo
M_WorkerDocument --> M_DepartmentDocumentType : belongsTo
M_WorkerDocument --> M_User : belongsTo
M_WorkerOffDay --> M_Worker : belongsTo
M_WorkerOffDay --> M_User : belongsTo
M_WorkerShift --> M_Worker : belongsTo
M_WorkerShift --> M_Shift : belongsTo
M_WorkerShiftHistory --> M_Worker : belongsTo
M_WorkerShiftHistory --> M_Shift : belongsTo
M_WorkerShiftHistory --> M_User : belongsTo

