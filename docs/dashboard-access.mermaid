```mermaid
---
title: Dashboard Access Control
---
flowchart TB
    %% Styles
    classDef admin fill:#dc2626,stroke:#991b1b,color:#fff,stroke-width:3px
    classDef employee fill:#ca8a04,stroke:#a16207,color:#fff,stroke-width:3px
    classDef feature fill:#2563eb,stroke:#1e40af,color:#fff,stroke-width:2px
    classDef stats fill:#16a34a,stroke:#15803d,color:#fff,stroke-width:2px

    %% Main Entry
    USER["👤 User Login"]:::admin

    %% Role Check
    USER --> CHECK{"Check Role"}:::admin

    %% Admin Dashboard Path
    CHECK -->|"Super Admin<br/>HR<br/>Manager"| ADMIN_DASH["🖥️ Admin Dashboard<br/>dashboard.admin<br/>/admin/dashboard"]:::admin

    %% Employee Dashboard Path
    CHECK -->|"Employee"| EMP_DASH["📱 Employee Dashboard<br/>dashboard.employee<br/>/employee/dashboard"]:::employee

    %% Admin Dashboard Features
    ADMIN_DASH --> ADMIN_FEAT1["📊 Global Statistics<br/>- Total Workers<br/>- Today Attendance<br/>- Pending Approvals"]:::stats
    ADMIN_DASH --> ADMIN_FEAT2["📈 Charts & Reports<br/>- Attendance Chart<br/>- Leave Statistics<br/>- Shift Swap Trends"]:::stats
    ADMIN_DASH --> ADMIN_FEAT3["⚡ Quick Actions<br/>- Add Worker<br/>- Input Attendance<br/>- View Reports<br/>- Manage Leave"]:::feature
    ADMIN_DASH --> ADMIN_FEAT4["📋 Recent Activities<br/>- Recent Leaves<br/>- Recent Shift Swaps<br/>- Today Absences"]:::feature

    %% Employee Dashboard Features
    EMP_DASH --> EMP_FEAT1["👤 Personal Profile<br/>- Name, Photo<br/>- NIP, Department<br/>- Join Date"]:::stats
    EMP_DASH --> EMP_FEAT2["✅ Quick Check-In<br/>- Today's Date<br/>- Check In Button<br/>- Biometric Icon"]:::feature
    EMP_DASH --> EMP_FEAT3["📊 Personal Stats<br/>- Attendance This Month<br/>- Leave Balance<br/>- Shift Swap Requests<br/>- Pending Requests"]:::stats
    EMP_DASH --> EMP_FEAT4["📅 My Schedule<br/>- Work Schedule<br/>- Upcoming Leaves<br/>- Recent Activities"]:::feature
    EMP_DASH --> EMP_FEAT5["📝 Submit Requests<br/>- Leave Request<br/>- Shift Swap<br/>- Business Trip"]:::feature

    %% Access Details
    subgraph ADMIN_ACCESS["🔑 Admin Dashboard Access"]
        direction LR
        ADM1["✅ Super Admin<br/>dashboard.admin"]:::admin
        ADM2["✅ HR<br/>dashboard.admin"]:::admin
        ADM3["✅ Manager<br/>dashboard.admin"]:::admin
    end

    subgraph EMP_ACCESS["🔑 Employee Dashboard Access"]
        direction LR
        EMP1["✅ Employee<br/>dashboard.employee"]:::employee
        EMP2["❌ Cannot access<br/>admin dashboard"]:::employee
    end

    %% Permission Requirements
    subgraph PERMS["📋 Permission Requirements"]
        direction TB
        P1["Admin Dashboard:<br/>dashboard.admin +<br/>role-specific permissions"]:::admin
        P2["Employee Dashboard:<br/>dashboard.employee +<br/>personal data permissions"]:::employee
    end
```
