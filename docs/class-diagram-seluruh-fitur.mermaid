classDiagram
    direction LR

    %% ==============================
    %% DOMAIN MODELS
    %% ==============================
    class User {
+id: uuid
+worker_id: uuid?
+email: string
+username: string
+password: string
+email_verified_at: datetime?
+last_login: datetime?
+is_active: bool
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+worker(): BelongsTo
+createdShiftOverrides(): HasMany
+verifiedDocuments(): HasMany
+approvedLeaveRequests(): HasMany
    }
    class Worker {
+id: uuid
+nip: string
+name: string
+email: string
+phone_number: string?
+address: text?
+birth_date: date?
+birth_place: string?
+gender: string?
+religion: string?
+department_id: uuid?
+shift_id: uuid?
+hire_date: date?
+resign_date: date?
+employment_status: string?
+status: string?
+photo_url: string?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+department(): BelongsTo
+shift(): BelongsTo
+user(): HasOne
+workerShifts(): HasMany
+shiftOverrides(): HasMany
+shiftHistories(): HasMany
+attendances(): HasMany
+workerDocuments(): HasMany
+leaveRequests(): HasMany
+shiftSwapRequestsAsRequester(): HasMany
+shiftSwapRequestsAsTarget(): HasMany
+offDays(): HasMany
+activeWorkerShift(): HasOne
+getShiftForDate(date): ?string
+isOffDay(date): bool
+canCheckOutOnDate(checkOutDate, checkInDate): bool
+getCurrentShift(): ?Shift
+resolveShiftForDate(date): array
    }
    class Department {
+id: uuid
+name: string
+code: string?
+description: text?
+is_active: bool
+requires_holiday_attendance: bool
+parent_id: uuid?
+manager_id: uuid?
+created_at: datetime
+updated_at: datetime
+workers(): HasMany
+parent(): BelongsTo
+children(): HasMany
+manager(): BelongsTo
+documentTypes(): BelongsToMany
    }
    class Role {
+id: uuid|int
+name: string
+guard_name: string
+created_at: datetime
+updated_at: datetime
    }
    class Permission {
+id: uuid|int
+name: string
+guard_name: string
+created_at: datetime
+updated_at: datetime
    }

    class Shift {
+id: uuid
+name: string
+start_time: time
+end_time: time
+total_hours: int
+grace_period_minutes: int
+is_overnight: bool
+is_active: bool
+created_at: datetime
+updated_at: datetime
+workerShifts(): HasMany
+dayTimes(): HasMany
+shiftOverrides(): HasMany
+attendances(): HasMany
+getScheduleForDate(date): array
    }
    class ShiftDayTime {
+id: uuid
+shift_id: uuid
+day_of_week: int
+start_time: time
+end_time: time
+created_at: datetime
+updated_at: datetime
+shift(): BelongsTo
    }
    class WorkerShift {
+id: uuid
+worker_id: uuid
+shift_id: uuid
+effective_from: date
+effective_until: date?
+is_active: bool
+notes: text?
+created_at: datetime
+updated_at: datetime
+getStartDateAttribute(): ?string
+getEndDateAttribute(): ?string
+worker(): BelongsTo
+shift(): BelongsTo
+getShiftForDate(date): ?string
+isActiveOnDate(date): bool
    }
    class WorkerShiftHistory {
+id: uuid
+worker_id: uuid
+shift_id: uuid
+effective_from: date?
+effective_until: date?
+changed_at: date
+change_reason: string
+changed_by: uuid?
+notes: text?
+created_at: datetime
+updated_at: datetime
+worker(): BelongsTo
+shift(): BelongsTo
+changedByUser(): BelongsTo
+logChange(...): self
    }
    class ShiftOverride {
+id: uuid
+worker_id: uuid
+shift_id: uuid
+override_date: date
+reason: string?
+created_by: uuid?
+shift_swap_request_id: uuid?
+created_at: datetime
+updated_at: datetime
+worker(): BelongsTo
+shift(): BelongsTo
+creator(): BelongsTo
+shiftSwapRequest(): BelongsTo
    }
    class WorkerOffDay {
+id: uuid
+worker_id: uuid
+day_of_week: int[]
+effective_from: date
+effective_until: date?
+reason: string?
+created_by: uuid?
+created_at: datetime
+updated_at: datetime
+worker(): BelongsTo
+createdBy(): BelongsTo
+getActiveRules(workerId, date): Collection
+isOffDay(workerId, date): bool
+isOffDayByPattern(workerId, date): bool
    }

    class Attendance {
+id: uuid
+worker_id: uuid
+shift_id: uuid?
+attendance_date: date
+check_in: datetime?
+check_out: datetime?
+distance_check_in: int?
+distance_check_out: int?
+check_in_by_admin: bool
+check_in_admin_id: uuid?
+check_out_by_admin: bool
+check_out_admin_id: uuid?
+status: enum(present|late|absent|sick|permission|leave)
+is_late: bool
+late_minutes: int
+is_early_leave: bool
+early_leave_minutes: int
+notes: text?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+worker(): BelongsTo
+shift(): BelongsTo
+checkInAdmin(): BelongsTo
+checkOutAdmin(): BelongsTo
+photos(): HasMany
+checkInPhoto(): HasMany
+checkOutPhoto(): HasMany
+getCheckInAdminDisplayNameAttribute(): ?string
+getCheckOutAdminDisplayNameAttribute(): ?string
    }
    class AttendancePhoto {
+id: uuid
+attendance_id: uuid
+photo_path: string
+photo_type: enum(check_in|check_out)
+taken_at: datetime
+created_at: datetime
+booted(): void
+attendance(): BelongsTo
    }

    class LeaveType {
+id: uuid
+name: string
+code: string
+max_days_per_year: int
+requires_approval: bool
+requires_attachment: bool
+days_notice: int
+is_active: bool
+created_at: datetime
+updated_at: datetime
+leaveRequests(): HasMany
    }
    class LeaveRequest {
+id: uuid
+worker_id: uuid
+leave_type_id: uuid
+start_date: date
+end_date: date
+total_days: int
+reason: text
+attachment_path: string?
+status: enum(pending|approved|rejected|cancelled)
+approved_by: uuid?
+approved_at: datetime?
+rejection_reason: text?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+getAttachmentAttribute(): ?string
+setAttachmentAttribute(value): void
+worker(): BelongsTo
+leaveType(): BelongsTo
+approver(): BelongsTo
    }

    class BusinessTrip {
+id: uuid
+worker_id: uuid
+destination: string
+purpose: text
+start_date: date
+end_date: date
+trip_duration_type: enum(full_day|half_day)
+half_day_session: enum(pagi|siang)?
+transportation: string?
+accommodation: string?
+notes: text?
+supporting_document_path: string?
+estimated_cost: decimal?
+status: enum(pending|approved|rejected|cancelled)
+approved_by: uuid?
+approved_at: datetime?
+rejection_reason: text?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+worker(): BelongsTo
+approvedBy(): BelongsTo
+getHalfDaySessionLabelAttribute(): ?string
+getDurationValueAttribute(): float|int
+getDurationLabelAttribute(): string
    }

    class DocumentType {
+id: uuid
+name: string
+description: text?
+file_format: string?
+max_file_size: int?
+is_required: bool
+is_universal: bool
+is_active: bool
+created_at: datetime
+updated_at: datetime
+workerDocuments(): HasMany
+departments(): BelongsToMany
    }
    class DepartmentDocumentType {
+id: uuid
+department_id: uuid
+document_type_id: uuid
+created_at: datetime
+updated_at: datetime
+department(): BelongsTo
+documentType(): BelongsTo
    }
    class WorkerDocument {
+id: uuid
+worker_id: uuid
+document_type_id: uuid
+department_document_type_id: uuid?
+file_name: string
+file_path: string
+file_size: int
+expired_date: date?
+status: enum(pending|verified|rejected)
+verified_by: uuid?
+verified_at: datetime?
+notes: text?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+worker(): BelongsTo
+documentType(): BelongsTo
+departmentDocumentType(): BelongsTo
+verifier(): BelongsTo
+isExpired(): bool
+getFileSizeHumanAttribute(): string
    }

    class ShiftSwapRequest {
+id: uuid
+requester_id: uuid
+target_worker_id: uuid
+requester_shift_id: uuid
+target_shift_id: uuid
+swap_type: enum(single_date|date_range)
+swap_start_date: date
+swap_end_date: date?
+swap_dates: date[]?
+status: enum(pending|accepted|awaiting_approval|approved|rejected|executed|cancelled)
+requires_manager_approval: bool
+manager_id: uuid?
+manager_approved_at: datetime?
+reason: text?
+metadata: json?
+requested_at: datetime?
+executed_by: uuid?
+executed_at: datetime?
+created_at: datetime
+updated_at: datetime
+deleted_at: datetime?
+getSwapDateAttribute()
+setSwapDateAttribute(value): void
+requester(): BelongsTo
+targetWorker(): BelongsTo
+requesterShift(): BelongsTo
+targetShift(): BelongsTo
+manager(): BelongsTo
+executedBy(): BelongsTo
+auditLogs(): HasMany
    }
    class ShiftSwapAuditLog {
+id: uuid
+shift_swap_request_id: uuid
+user_id: uuid?
+action: string
+old_status: string?
+new_status: string?
+notes: text?
+metadata: json?
+user_agent: string?
+created_at: datetime
+updated_at: datetime
+shiftSwapRequest(): BelongsTo
+user(): BelongsTo
+log(...): self
    }

    class Holiday {
+id: uuid
+name: string
+date: date
+description: text?
+is_national: bool
+created_at: datetime
+updated_at: datetime
+scopeNational(query)
+scopeDateRange(query, start, end)
+scopeYear(query, year)
    }
    class Notification {
+id: uuid
+user_id: uuid?
+notifiable_type: string?
+notifiable_id: uuid?
+type: string
+title: string
+message: text
+data: json?
+read_at: datetime?
+created_at: datetime
+updated_at: datetime
+booted(): void
+notifiable(): MorphTo
+user(): BelongsTo
+isRead(): bool
+markAsRead(): void
+scopeUnread(query)
+scopeRead(query)
+getTitleAttribute(value): string
+getMessageAttribute(value): string
+getIsReadAttribute(): bool
    }
    class AuditLog {
+id: uuid
+user_id: uuid?
+user_name: string
+action: string
+auditable_type: string?
+auditable_id: uuid?
+description: text?
+old_values: json?
+new_values: json?
+ip_address: string?
+user_agent: string?
+url: string?
+created_at: datetime
+updated_at: datetime
+user(): BelongsTo
+auditable(): MorphTo
+scopeForModel(query, modelClass, modelId)
+scopeByUser(query, userId)
+scopeByAction(query, action)
+scopeRecent(query, days)
+log(...): self
+getModelNameAttribute(): string
+getActionBadgeAttribute(): array
    }

    User "1" --> "0..1" Worker : belongsTo
    Worker "*" --> "1" Department : belongsTo
    User "*" --> "*" Role : hasRoles
    Role "*" --> "*" Permission : hasPermissions

    Shift "1" --> "*" ShiftDayTime : hasMany
    Worker "1" --> "*" WorkerShift : hasMany
    Worker "1" --> "*" ShiftOverride : hasMany
    Worker "1" --> "*" WorkerOffDay : hasMany
    Worker "1" --> "*" WorkerShiftHistory : hasMany

    Worker "1" --> "*" Attendance : hasMany
    Attendance "1" --> "*" AttendancePhoto : hasMany
    Attendance "*" --> "1" Shift : belongsTo

    Worker "1" --> "*" LeaveRequest : hasMany
    LeaveRequest "*" --> "1" LeaveType : belongsTo

    Worker "1" --> "*" BusinessTrip : hasMany

    Worker "1" --> "*" WorkerDocument : hasMany
    WorkerDocument "*" --> "1" DocumentType : belongsTo
    Department "1" --> "*" DepartmentDocumentType : hasMany
    DepartmentDocumentType "*" --> "1" DocumentType : belongsTo

    Worker "1" --> "*" ShiftSwapRequest : requester
    Worker "1" --> "*" ShiftSwapRequest : target
    ShiftSwapRequest "1" --> "*" ShiftSwapAuditLog : hasMany

    Worker "1" --> "*" Notification : receives
    User "1" --> "*" AuditLog : creates

