%% Core relationships
Worker --> Department : belongsTo
Worker --> Shift : belongsTo
Worker --> User : hasOne
Worker --> "*" WorkerShift : hasMany
Worker --> "*" Attendance : hasMany
Worker --> "*" WorkerDocument : hasMany
Worker --> "*" LeaveRequest : hasMany
Worker --> "*" BusinessTrip : hasMany
Worker --> "*" ShiftSwapRequest : hasMany
Worker --> "*" ShiftOverride : hasMany
Worker --> "*" WorkerDocument : hasMany
Shift --> "*" WorkerShift : hasMany
Shift --> "*" Attendance : hasMany
Shift --> "*" ShiftOverride : hasMany
LeaveRequest --> Worker : belongsTo
LeaveRequest --> LeaveType : belongsTo
WorkerDocument --> Worker : belongsTo
WorkerDocument --> DocumentType : belongsTo
BusinessTrip --> Worker : belongsTo
ShiftSwapRequest --> Worker : belongsTo
ShiftSwapRequest --> WorkerShift : belongsTo
ShiftSwapRequest --> "*" ShiftSwapRequest : hasMany
ShiftOverride --> Worker : belongsTo
ShiftOverride --> Shift : belongsTo
Holiday --> Department : scope
Department --> User : belongsTo

