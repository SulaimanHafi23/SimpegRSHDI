%%{init: {"theme": "base", "themeVariables": {"background": "#dddddd", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "textColor": "#000000", "actorBkg": "#ffffff", "actorBorder": "#000000", "actorTextColor": "#000000", "activationBkgColor": "#ffffff", "activationBorderColor": "#000000", "signalColor": "#000000", "signalTextColor": "#000000", "labelBoxBkgColor": "#ffffff", "labelBoxBorderColor": "#000000", "labelTextColor": "#000000", "sequenceNumberColor": "#000000", "noteBkgColor": "#ffffff", "noteBorderColor": "#000000", "noteTextColor": "#000000"}, "sequence": {"useMaxWidth": true, "wrap": true, "messageFontSize": 12, "noteFontSize": 12}}}%%
sequenceDiagram
    autonumber
    actor A as Pengguna
    participant UI as Web UI :boundary
    participant C as ProfileController :control
    participant M as User Model :entity
    participant DB as Database :entity

    A->>UI: Isi form ubah password (lama, baru, konfirmasi)
    UI->>C: PUT /profile/password
    C->>C: Validasi input request
    alt Input tidak valid
        C-->>UI: Validasi gagal (422)
        UI-->>A: Tampilkan error validasi
    else Input valid
        C->>+M: Verifikasi password lama user
        M->>+DB: SELECT users by id
        DB-->>-M: Data user
        alt Password lama tidak valid
            M-->>C: Throw error password lama salah
            C-->>UI: Gagal ubah password
            UI-->>A: Password lama tidak sesuai
        else Password lama valid
            C->>+M: Update password baru (hash)
            M->>+DB: UPDATE users SET password = hash
            DB-->>-M: Perubahan tersimpan
            M-->>C: Password berhasil diubah
            C-->>UI: Response sukses
            UI-->>A: Tampilkan pesan berhasil
        end
    end


