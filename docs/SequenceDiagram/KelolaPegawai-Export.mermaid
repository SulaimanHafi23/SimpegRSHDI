%%{init: {"theme": "base", "themeVariables": {"background": "#dddddd", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "textColor": "#000000", "actorBkg": "#ffffff", "actorBorder": "#000000", "actorTextColor": "#000000", "activationBkgColor": "#ffffff", "activationBorderColor": "#000000", "signalColor": "#000000", "signalTextColor": "#000000", "labelBoxBkgColor": "#ffffff", "labelBoxBorderColor": "#000000", "labelTextColor": "#000000", "sequenceNumberColor": "#000000", "noteBkgColor": "#ffffff", "noteBorderColor": "#000000", "noteTextColor": "#000000"}, "sequence": {"useMaxWidth": true, "wrap": true, "messageFontSize": 12, "noteFontSize": 12}}}%%
sequenceDiagram
    autonumber
    actor A as HR/Admin
    participant UI as Web UI
    participant C as WorkerController
    participant WS as WorkersExport / PDF Export
    participant W as Worker Model
    participant DB as Database

    A->>UI: Klik Export Data Pegawai
    UI->>C: GET /workers/export?format=pdf|excel|csv&filter=...
    C->>C: authorizePermission(worker.manage)
    alt Format = pdf
        C->>W: Build query + apply filters
        W->>DB: SELECT workers + department
        DB-->>W: Dataset workers
        W-->>C: Data workers siap export
        C->>WS: Render workers-pdf
        WS-->>C: File PDF
        C-->>UI: Download data-pegawai-*.pdf
        UI-->>A: File PDF terunduh
    else Format = excel/csv
        C->>WS: Create WorkersExport(filters)
        WS->>DB: SELECT workers sesuai filter
        DB-->>WS: Dataset workers
        WS-->>C: File Excel/CSV
        C-->>UI: Download data-pegawai-*.xlsx/.csv
        UI-->>A: File Excel/CSV terunduh
    else Terjadi exception
        C-->>UI: Redirect back + error message
        UI-->>A: Tampilkan notifikasi gagal export
    end


