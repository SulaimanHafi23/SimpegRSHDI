---
id: KelolaShiftOverride-UbahShiftOverride
title: Kelola Shift Override - Ubah Shift Override
---
%%{init: {"theme": "base", "themeVariables": {"background": "#dddddd", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "textColor": "#000000", "actorBkg": "#ffffff", "actorBorder": "#000000", "actorTextColor": "#000000", "activationBkgColor": "#ffffff", "activationBorderColor": "#000000", "signalColor": "#000000", "signalTextColor": "#000000", "labelBoxBkgColor": "#ffffff", "labelBoxBorderColor": "#000000", "labelTextColor": "#000000", "sequenceNumberColor": "#000000", "noteBkgColor": "#ffffff", "noteBorderColor": "#000000", "noteTextColor": "#000000"}, "sequence": {"useMaxWidth": true, "wrap": true, "messageFontSize": 12, "noteFontSize": 12}}}%%
sequenceDiagram
    autonumber
    actor HR as HR/Manager
    participant UI as Web UI :boundary
    participant C as ShiftOverrideController :control
    participant SO as ShiftOverride Model :entity
    participant DB as Database :entity

    HR->>UI: Klik tombol Edit pada shift override tertentu
    UI->>C: GET /admin/shift-overrides/{id}
    C->>+SO: Find override dengan relasi
    SO->>+DB: SELECT so.*, w.name, w.nip, s.name as shift_name FROM ... WHERE so.id = ?
    DB-->>-SO: Override data
    SO-->>C: ShiftOverride instance
    C-->>UI: Response dengan data
    UI->>UI: Tampilkan form dengan data terpre-fill
    HR->>UI: Ubah shift/tanggal/alasan dan klik Simpan
    UI->>C: PUT /admin/shift-overrides/{id}
    note over C: Validasi: shift ada, tanggal valid
    alt Validasi berhasil
        C->>+SO: Update override
        SO->>+DB: UPDATE shift_overrides SET shift_id = ?, date = ?, reason = ?, updated_at = NOW() WHERE id = ?
        DB-->>-SO: Override berhasil diperbarui
        SO-->>C: Updated instance
        C-->>UI: Response sukses
        UI-->>HR: Notifikasi perubahan berhasil
    else Validasi gagal
        C-->>UI: Response error
        UI-->>HR: Tampilkan pesan error
    end

