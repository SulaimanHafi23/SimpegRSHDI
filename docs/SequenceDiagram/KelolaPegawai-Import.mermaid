%%{init: {"theme": "base", "themeVariables": {"background": "#dddddd", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "textColor": "#000000", "actorBkg": "#ffffff", "actorBorder": "#000000", "actorTextColor": "#000000", "activationBkgColor": "#ffffff", "activationBorderColor": "#000000", "signalColor": "#000000", "signalTextColor": "#000000", "labelBoxBkgColor": "#ffffff", "labelBoxBorderColor": "#000000", "labelTextColor": "#000000", "sequenceNumberColor": "#000000", "noteBkgColor": "#ffffff", "noteBorderColor": "#000000", "noteTextColor": "#000000"}, "sequence": {"useMaxWidth": true, "wrap": true, "messageFontSize": 12, "noteFontSize": 12}}}%%
sequenceDiagram
    autonumber
    actor A as HR/Admin
    participant UI as Web UI :boundary
    participant C as WorkerController :control
    participant I as WorkersImport :control
    participant DB as Database :entity

    A->>UI: Upload file import pegawai (.xlsx/.xls/.csv)
    UI->>C: POST /workers/import
    C->>C: authorizePermission(worker.manage)
    C->>C: Validasi file (required, mime, max 5MB)
    alt File tidak valid
        C-->>UI: Validasi gagal
        UI-->>A: Tampilkan error file import
    else File valid
        C->>I: Excel::import(WorkersImport, file)
        I->>+DB: Insert/update data worker per baris
        DB-->>I: Hasil import per row
        I-->>C: successCount + error list
        alt Ada error dan successCount > 0
            C-->>UI: Warning (sebagian berhasil)
            UI-->>A: Berhasil sebagian + ringkasan error
        else Semua baris gagal
            C-->>UI: Error gagal import
            UI-->>A: Tampilkan detail error import
        else Semua berhasil
            C-->>UI: Success import
            UI-->>A: Berhasil import semua data
        end
    end


