---
id: Autentikasi-ResetPassword
title: Autentikasi - Reset Password
---
%%{init: {"theme": "base", "themeVariables": {"background": "#dddddd", "primaryColor": "#ffffff", "primaryBorderColor": "#000000", "primaryTextColor": "#000000", "lineColor": "#000000", "textColor": "#000000", "actorBkg": "#ffffff", "actorBorder": "#000000", "actorTextColor": "#000000", "activationBkgColor": "#ffffff", "activationBorderColor": "#000000", "signalColor": "#000000", "signalTextColor": "#000000", "labelBoxBkgColor": "#ffffff", "labelBoxBorderColor": "#000000", "labelTextColor": "#000000", "sequenceNumberColor": "#000000", "noteBkgColor": "#ffffff", "noteBorderColor": "#000000", "noteTextColor": "#000000"}, "sequence": {"useMaxWidth": true, "wrap": true, "messageFontSize": 12, "noteFontSize": 12}}}%%
sequenceDiagram
    autonumber
    actor U as User
    participant UI as Web UI :boundary
    participant C as AuthController :control
    participant M as User :entity
    participant RT as ResetToken :entity
    participant DB as Database :entity

    U->>UI: Buka tautan reset password dari email
    UI->>C: GET /reset-password/{token}
    C->>+RT: Validasi token reset dan masa berlaku
    RT->>+DB: SELECT token reset by value + expiry
    activate DB
    DB-->>-RT: Data token
    deactivate DB

    alt Token valid
        RT-->>C: Token valid
        C-->>UI: Tampilkan form password baru
        U->>UI: Isi password baru dan konfirmasi
        UI->>C: POST /reset-password
        C->>+M: Update password user
        activate M
        M->>+DB: UPDATE users SET password = hash(new_password)
        activate DB
        DB-->>-M: Password diperbarui
        deactivate DB
        M-->>C: Password update sukses
        deactivate M
        C->>+DB: Hapus token reset
        activate DB
        DB-->>C: Token reset dihapus
        deactivate DB
        C-->>UI: Response sukses
        UI-->>U: Arahkan ke halaman login
    else Token tidak valid / kedaluwarsa
        RT-->>C: Token tidak valid / kedaluwarsa
        C-->>UI: Response error
        UI-->>U: Tampilkan pesan token tidak valid atau expired
    end

