sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (admin.master.leave-types.index/show)"
    participant C as LeaveTypeController
    participant LT as "LeaveType Model"
    participant LR as "LeaveRequest Model"
    participant DB as "Database"

    Admin->>View: Klik Hapus pada data tipe cuti
    View->>C: DELETE /admin/master/leave-types/{id}

    C->>LT: Cari leave type by id
    LT->>DB: SELECT * FROM leave_types WHERE id = ?
    DB-->>LT: Data leave type

    C->>LR: Cek apakah tipe cuti masih dipakai
    LR->>DB: SELECT EXISTS leave_requests WHERE leave_type_id = ?
    DB-->>LR: Status dipakai/tidak

    alt Data valid (tidak dipakai)
        C->>LT: Hapus tipe cuti
        LT->>DB: DELETE FROM leave_types WHERE id = ?
        C-->>View: Redirect ke index + flash success
        View-->>Admin: Data tipe cuti terhapus
    else Data tidak valid (masih dipakai/tidak ditemukan)
        C-->>View: Redirect back + pesan gagal hapus
        View-->>Admin: Tampilkan error
    end
