sequenceDiagram
    autonumber
    actor Admin as Admin/HR/Manager
    participant View as "Web View (admin.attendance.check-out)"
    participant C as AttendanceController
    participant A as "Attendance Model"
    participant W as "Worker Model"
    participant S as "Shift Model"
    participant AP as "AttendancePhoto Model"
    participant DB as "Database"

    Admin->>View: Isi form check-out admin untuk attendance
    View->>C: POST /admin/attendance/{attendance}/check-out

    C->>C: Validasi request (note, photo)
    C->>A: Ambil attendance by id
    A->>DB: SELECT attendance by id
    DB-->>A: Data attendance / null

    C->>W: Validasi worker + izin check-out
    W->>DB: SELECT worker + validasi off-day checkout
    DB-->>W: Hasil validasi

    C->>S: Ambil shift & jadwal untuk hitung early leave
    S->>DB: SELECT shift by attendance.shift_id
    DB-->>S: Data shift

    alt Data valid
        C->>A: Update check-out attendance (by_admin=true, admin_id)
        A->>DB: UPDATE attendances SET check_out..., early_leave... WHERE id = ?
        C->>AP: Simpan foto check-out (jika ada)
        AP->>DB: INSERT INTO attendance_photos (...)
        C-->>View: Redirect ke detail absensi + success/warning
        View-->>Admin: Tampilkan check-out berhasil
    else Data tidak valid
        C-->>View: Redirect back + pesan gagal check-out
        View-->>Admin: Tampilkan error
    end
