sequenceDiagram
    autonumber
    actor Pegawai as "Pegawai"
    participant View as "Web View (employee.business-trips.index)"
    participant Controller as "Employee BusinessTripController"
    participant Model as "BusinessTrip Model"
    participant DB as "Database"

    Pegawai->>View: Klik Export (PDF/Excel/CSV)
    View->>Controller: GET /employee/business-trips/export?filter&format
    Controller->>Model: Build query export sesuai pegawai login
    Model->>DB: SELECT business_trips WHERE worker_id = ?
    DB-->>Model: Dataset export
    Model-->>Controller: Data siap diekspor

    alt Data valid (format valid dan data tersedia)
        Controller->>View: Return file pdf/xlsx/csv
        View-->>Pegawai: File perjalanan dinas berhasil diunduh
    else Data tidak valid (worker tidak ditemukan / filter error / format invalid)
        Controller->>View: Redirect back + error
        View-->>Pegawai: Notifikasi gagal ekspor perjalanan dinas
    end
