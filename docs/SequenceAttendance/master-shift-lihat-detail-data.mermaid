sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (admin.master.shifts.show)"
    participant C as ShiftController
    participant S as "Shift Model"
    participant SDT as "ShiftDayTime Model"
    participant WS as "WorkerShift Model"
    participant A as "Attendance Model"
    participant DB as "Database"

    Admin->>View: Buka detail shift
    View->>C: GET /admin/master/shifts/{id}

    C->>S: Ambil shift by id + relasi day_times
    S->>DB: SELECT shifts + shift_day_times WHERE shift_id = ?
    DB-->>S: Data shift + jadwal harian

    C->>WS: Hitung statistik worker shift
    WS->>DB: COUNT worker_shifts (total/aktif) by shift_id
    DB-->>WS: Statistik worker

    C->>A: Hitung attendance hari ini untuk shift
    A->>DB: COUNT attendances WHERE shift_id = ? AND tanggal = hari ini
    DB-->>A: Statistik attendance

    alt Data valid
        C-->>View: Render halaman detail + statistik
        View-->>Admin: Tampilkan detail lengkap shift
    else Data tidak valid
        C-->>View: Redirect ke index + error "Shift tidak ditemukan"
        View-->>Admin: Tampilkan pesan error
    end
