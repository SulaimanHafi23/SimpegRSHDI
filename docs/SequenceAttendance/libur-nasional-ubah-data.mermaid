sequenceDiagram
    autonumber
    actor Admin as "Admin/HR/Manager"
    participant View as "Web View (admin.holidays.edit)"
    participant Controller as "Admin HolidayController"
    participant Model as "Holiday Model"
    participant DB as "Database"

    Admin->>View: Ubah data lalu klik Update
    View->>Controller: PUT /admin/holidays/{id}
    Controller->>Controller: Validasi input edit
    Controller->>Model: findOrFail(id) + update(validated)
    Model->>DB: UPDATE holidays SET name, date, description, is_national
    DB-->>Model: Update success
    Model-->>Controller: Holiday berhasil diperbarui

    alt Data valid (id ditemukan dan input valid)
        Controller->>View: Redirect index + success
        View-->>Admin: Notifikasi libur berhasil diperbarui
    else Data tidak valid (id invalid / validasi gagal)
        Controller->>View: Back + error
        View-->>Admin: Notifikasi gagal mengubah libur
    end
