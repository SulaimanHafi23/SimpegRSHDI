sequenceDiagram
    autonumber
    actor Admin as Admin/HR/Manager
    participant View as "Web View (admin.schedules.generate)"
    participant C as WorkerShiftController
    participant Svc as WorkerShiftService
    participant WS as "WorkerShift Model"
    participant WSH as "WorkerShiftHistory Model"
    participant DB as "Database"

    Admin->>View: Isi form generate rotasi (weekly/monthly)
    View->>C: POST /admin/worker-shifts/generate

    C->>C: Validasi request (worker_ids, sequence, periode)

    alt Data valid
        C->>Svc: deleteOldShifts(worker) jika deactivate_existing
        Svc->>WSH: Log shift lama ke history
        WSH->>DB: INSERT worker_shift_histories (...)
        Svc->>WS: Hapus shift lama worker
        WS->>DB: DELETE worker_shifts WHERE worker_id = ?

        loop Tiap periode rotasi x tiap worker
            C->>Svc: create(shift periode)
            Svc->>WS: Simpan jadwal periode
            WS->>DB: INSERT INTO worker_shifts (...)
        end

        C-->>View: Redirect ke index + success (jumlah periode/data)
        View-->>Admin: Rotasi jadwal berhasil dibuat
    else Data tidak valid
        C-->>View: Redirect back + pesan gagal generate
        View-->>Admin: Tampilkan error
    end
