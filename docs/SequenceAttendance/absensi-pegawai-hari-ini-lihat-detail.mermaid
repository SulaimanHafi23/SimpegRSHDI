sequenceDiagram
    autonumber
    actor Admin as Admin/HR/Manager
    participant View as "Web View (admin.attendance.show dari tab today)"
    participant C as AttendanceController
    participant A as "Attendance Model"
    participant W as "Worker Model"
    participant S as "Shift Model"
    participant AP as "AttendancePhoto Model"
    participant U as "User Model"
    participant DB as "Database"

    Admin->>View: Klik detail absensi pegawai hari ini
    View->>C: GET /admin/attendance/{attendanceId}

    C->>A: Ambil attendance by id + relasi
    A->>DB: SELECT attendances + worker + shift + photos + admin checkin/checkout
    DB-->>A: Detail attendance

    alt Data valid
        C-->>View: Render detail absensi
        View-->>Admin: Tampilkan detail check-in/check-out, foto, status
    else Data tidak valid
        C-->>View: Redirect ke index + error "Data absensi tidak ditemukan"
        View-->>Admin: Tampilkan pesan error
    end
