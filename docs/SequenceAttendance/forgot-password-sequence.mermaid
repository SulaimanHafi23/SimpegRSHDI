sequenceDiagram
    autonumber
    actor Pengguna
    participant View as "Web View (auth.forgot-password)"
    participant C as ForgotPasswordController
    participant U as "User Model"
    participant W as "Worker Model"
    participant DB as "Database"

    Pengguna->>View: Isi email lalu submit POST /forgot-password
    View->>C: sendResetLinkEmail(email)

    C->>C: Validasi format email
    C->>U: Cari email di users
    U->>DB: SELECT email FROM users WHERE email = input
    DB-->>U: Hasil pencarian
    C->>W: Fallback cari email di workers + relasi user
    W->>DB: SELECT workers + users terkait (jika diperlukan)
    DB-->>W: Hasil fallback

    alt Data valid (email akun ditemukan)
        C->>DB: Password::sendResetLink(targetEmail)
        DB->>DB: UPSERT token ke password_reset_tokens
        C-->>View: Redirect back + status sukses
        View-->>Pengguna: Notifikasi link reset terkirim
    else Data tidak valid
        C-->>View: Redirect back + pesan email tidak ditemukan/gagal kirim
        View-->>Pengguna: Tampilkan error
    end
