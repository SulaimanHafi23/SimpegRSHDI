sequenceDiagram
    autonumber
    actor Admin as Admin/HR/Manager
    participant View as "Web View (admin.schedules.edit)"
    participant C as WorkerShiftController
    participant Svc as WorkerShiftService
    participant WS as "WorkerShift Model"
    participant WSH as "WorkerShiftHistory Model"
    participant DB as "Database"

    Admin->>View: Ubah data jadwal pegawai lalu submit
    View->>C: PUT /admin/worker-shifts/{id}

    C->>C: Validasi input update

    alt Data valid
        C->>Svc: update(id, payload)
        Svc->>WS: Ambil jadwal lama
        WS->>DB: SELECT worker_shifts WHERE id = ?
        Svc->>WSH: Log jadwal lain ke history (shift_replaced)
        WSH->>DB: INSERT worker_shift_histories (...)
        Svc->>WS: Hapus jadwal lama lain worker (exclude current)
        WS->>DB: DELETE worker_shifts WHERE worker_id=? AND id!=?
        Svc->>WS: Update jadwal target
        WS->>DB: UPDATE worker_shifts SET ... WHERE id=?
        C-->>View: Redirect ke detail + success
        View-->>Admin: Detail jadwal terbarui
    else Data tidak valid
        C-->>View: Redirect back + error
        View-->>Admin: Tampilkan pesan gagal update
    end
