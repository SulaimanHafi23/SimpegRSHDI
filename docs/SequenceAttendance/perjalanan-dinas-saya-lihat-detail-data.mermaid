sequenceDiagram
    autonumber
    actor Pegawai as "Pegawai"
    participant View as "Web View (employee.business-trips.show)"
    participant Controller as "Employee BusinessTripController"
    participant Model as "BusinessTrip Model"
    participant DB as "Database"

    Pegawai->>View: Klik detail perjalanan dinas
    View->>Controller: GET /employee/business-trips/{id}
    Controller->>Model: findOrFail(id) + validasi kepemilikan
    Model->>DB: SELECT business_trips by id
    DB-->>Model: Data detail perjalanan dinas
    Model-->>Controller: Entitas BusinessTrip

    alt Data valid (id milik pegawai login)
        Controller->>View: Render halaman detail
        View-->>Pegawai: Detail perjalanan dinas tampil
    else Data tidak valid (id tidak ditemukan / tidak berhak akses)
        Controller->>View: 403/redirect + error
        View-->>Pegawai: Notifikasi gagal melihat detail
    end
