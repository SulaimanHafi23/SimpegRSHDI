sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (admin.master.leave-types.edit)"
    participant C as LeaveTypeController
    participant LT as "LeaveType Model"
    participant DB as "Database"

    Admin->>View: Ubah data tipe cuti lalu submit
    View->>C: PUT /admin/master/leave-types/{id}

    C->>C: Validasi input update
    C->>LT: Cari leave type berdasarkan id
    LT->>DB: SELECT * FROM leave_types WHERE id = ?
    DB-->>LT: Data leave type / null

    alt Data valid
        C->>LT: Update data tipe cuti
        LT->>DB: UPDATE leave_types SET ... WHERE id = ?

        C-->>View: Redirect ke detail tipe cuti + flash success
        View-->>Admin: Detail tipe cuti terbarui
    else Data tidak valid
        C-->>View: Redirect back + error
        View-->>Admin: Tampilkan pesan gagal update
    end
