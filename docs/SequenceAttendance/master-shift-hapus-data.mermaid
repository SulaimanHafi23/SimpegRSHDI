sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (admin.master.shifts.index/show)"
    participant C as ShiftController
    participant S as "Shift Model"
    participant WS as "WorkerShift Model"
    participant DB as "Database"

    Admin->>View: Klik Hapus pada data shift
    View->>C: DELETE /admin/master/shifts/{id}

    C->>S: Cari shift by id
    S->>DB: SELECT * FROM shifts WHERE id = ?
    DB-->>S: Data shift

    C->>WS: Cek apakah shift masih dipakai pegawai
    WS->>DB: SELECT EXISTS worker_shifts WHERE shift_id = ?
    DB-->>WS: Status dipakai/tidak

    alt Data valid (shift tidak dipakai)
        C->>S: Hapus shift
        S->>DB: DELETE FROM shifts WHERE id = ?
        C-->>View: Redirect ke index + flash success
        View-->>Admin: Data shift terhapus
    else Data tidak valid (shift masih dipakai/tidak ditemukan)
        C-->>View: Redirect back + pesan gagal hapus
        View-->>Admin: Tampilkan error
    end
