sequenceDiagram
    autonumber
    actor Admin as "Admin/Manager"
    participant View as "Web View (admin.leave.show)"
    participant Controller as "LeaveRequestController"
    participant Model as "LeaveRequest Model"
    participant DB as "Database"

    Admin->>View: Klik Setujui
    View->>Controller: POST /leaves/{id}/approve
    Controller->>Model: Ambil data pengajuan by id
    Model->>DB: SELECT leave_request by id
    DB-->>Model: Data pengajuan

    alt Data valid (status pending)
        Controller->>Model: approve(id, approved_by)
        Model->>DB: UPDATE leave_requests\nSET status='approved', approved_by=?, approved_at=NOW()
        DB-->>Model: Update success
        Model-->>Controller: Pengajuan disetujui
        Controller->>View: Redirect back + success
        View-->>Admin: Status berubah menjadi Disetujui
    else Data tidak valid (bukan pending/tidak ditemukan)
        Controller->>View: Redirect back + error
        View-->>Admin: Notifikasi gagal menyetujui cuti
    end
