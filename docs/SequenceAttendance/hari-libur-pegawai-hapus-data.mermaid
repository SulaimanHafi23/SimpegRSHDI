sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (off-days manager pada detail jadwal/worker)"
    participant C as WorkerOffDayController
    participant W as "Worker Model"
    participant WOD as "WorkerOffDay Model"
    participant DB as "Database"

    Admin->>View: Klik hapus pola hari libur
    View->>C: DELETE /admin/workers/{workerId}/off-days/patterns/{patternId}

    C->>W: Validasi worker
    W->>DB: SELECT workers WHERE id = ?
    DB-->>W: Data worker / null

    C->>WOD: Cari pola off-day milik worker
    WOD->>DB: SELECT worker_off_days WHERE id = ? AND worker_id = ?
    DB-->>WOD: Data pola / null

    alt Data valid
        C->>WOD: Hapus pola off-day
        WOD->>DB: DELETE FROM worker_off_days WHERE id = ?
        C-->>View: JSON success
        View-->>Admin: Hari libur berhasil dihapus
    else Data tidak valid
        C-->>View: JSON error
        View-->>Admin: Tampilkan pesan gagal hapus
    end
