sequenceDiagram
    autonumber
    actor Admin as "Manager/HR"
    participant View as "Web View (approvals.business-trips.show)"
    participant Controller as "BusinessTripApprovalController"
    participant Model as "BusinessTrip Model"
    participant DB as "Database"

    Admin->>View: Klik detail pengajuan perjalanan dinas
    View->>Controller: GET /approvals/business-trips/{id}
    Controller->>Model: findOrFail(id) + eager load relasi
    Model->>DB: SELECT business_trip + worker + approver
    DB-->>Model: Data detail pengajuan
    Model-->>Controller: Entitas BusinessTrip

    alt Data valid (id ditemukan dan akses valid)
        Controller->>View: Render halaman detail
        View-->>Admin: Detail pengajuan tampil
    else Data tidak valid (id tidak ada/unauthorized)
        Controller->>View: 404/403 atau back + error
        View-->>Admin: Notifikasi gagal melihat detail
    end
