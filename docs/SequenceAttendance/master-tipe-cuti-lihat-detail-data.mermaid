sequenceDiagram
    autonumber
    actor Admin as Admin/HR
    participant View as "Web View (admin.master.leave-types.show)"
    participant C as LeaveTypeController
    participant LT as "LeaveType Model"
    participant LR as "LeaveRequest Model"
    participant DB as "Database"

    Admin->>View: Buka detail tipe cuti
    View->>C: GET /admin/master/leave-types/{id}

    C->>LT: Ambil leave type by id + relasi leave_requests
    LT->>DB: SELECT leave_types + leave_requests WHERE leave_type_id = ?
    DB-->>LT: Data leave type + relasi

    C->>LR: Ambil jumlah pemakaian leave request
    LR->>DB: COUNT leave_requests WHERE leave_type_id = ?
    DB-->>LR: Statistik pemakaian

    alt Data valid
        C-->>View: Render halaman detail tipe cuti
        View-->>Admin: Tampilkan detail lengkap
    else Data tidak valid
        C-->>View: Redirect ke index + error "Tipe cuti tidak ditemukan"
        View-->>Admin: Tampilkan pesan error
    end
