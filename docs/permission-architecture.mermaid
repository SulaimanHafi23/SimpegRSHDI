```mermaid
---
title: SIMPEGRS Permission System Architecture
---
flowchart TB
    %% Define styles
    classDef superadmin fill:#dc2626,stroke:#991b1b,color:#fff,stroke-width:3px
    classDef hr fill:#2563eb,stroke:#1e40af,color:#fff,stroke-width:2px
    classDef manager fill:#16a34a,stroke:#15803d,color:#fff,stroke-width:2px
    classDef employee fill:#ca8a04,stroke:#a16207,color:#fff,stroke-width:2px
    classDef dashboard fill:#7c3aed,stroke:#6d28d9,color:#fff
    classDef module fill:#0891b2,stroke:#0e7490,color:#fff
    classDef action fill:#ec4899,stroke:#db2777,color:#fff

    %% Main System
    START["🔐 SIMPEGRS<br/>Permission System"]:::superadmin
    
    %% Four Main Roles
    START --> SA["👑 Super Admin<br/>42 Permissions<br/>ALL ACCESS"]:::superadmin
    START --> HR["👔 HR<br/>23 Permissions<br/>Management & Config"]:::hr
    START --> MGR["📊 Manager<br/>16 Permissions<br/>Oversight & Approval"]:::manager
    START --> EMP["👤 Employee<br/>15 Permissions<br/>Personal Access"]:::employee
    
    %% Super Admin Access
    SA --> SA_DASH["✅ Dashboard Admin"]:::dashboard
    SA --> SA_ALL["✅ ALL Modules<br/>✅ ALL Actions"]:::action
    SA --> SA_ROLE["✅ Role Management<br/>✅ User Management"]:::module
    
    %% HR Access
    HR --> HR_DASH["✅ Dashboard Admin"]:::dashboard
    HR --> HR_MASTER["Master Data<br/>✅ Religion, Gender<br/>✅ Department, Location<br/>✅ Shift, Leave Type<br/>✅ Document Type<br/>✅ Holiday"]:::module
    HR --> HR_WORKER["Worker Management<br/>✅ Full CRUD<br/>✅ Attendance<br/>✅ Schedule<br/>✅ Documents"]:::module
    HR --> HR_APPROVE["Approvals<br/>✅ Leave Manage/Approve<br/>✅ Overtime Manage/Approve<br/>✅ Business Trip"]:::action
    HR --> HR_REPORT["Reports<br/>✅ View All<br/>✅ Export"]:::module
    HR --> HR_USER["✅ User Management<br/>❌ No Role Management"]:::module
    
    %% Manager Access
    MGR --> MGR_DASH["✅ Dashboard Admin"]:::dashboard
    MGR --> MGR_VIEW["View Access<br/>✅ Workers<br/>✅ Attendance<br/>✅ Departments<br/>✅ Shifts"]:::module
    MGR --> MGR_SCHEDULE["✅ Schedule Management"]:::module
    MGR --> MGR_APPROVE["Approval Authority<br/>✅ Leave<br/>✅ Overtime<br/>✅ Shift Swap<br/>✅ Business Trip"]:::action
    MGR --> MGR_REPORT["Reports<br/>✅ View<br/>✅ Export"]:::module
    
    %% Employee Access
    EMP --> EMP_DASH["✅ Dashboard Employee"]:::dashboard
    EMP --> EMP_PROFILE["Personal Data<br/>✅ View Profile<br/>✅ View Documents"]:::module
    EMP --> EMP_ATT["Attendance<br/>✅ Check In/Out<br/>✅ View Own History"]:::module
    EMP --> EMP_SCHEDULE["✅ View Own Schedule"]:::module
    EMP --> EMP_REQUEST["Submit Requests<br/>✅ Leave<br/>✅ Overtime<br/>✅ Shift Swap<br/>✅ Business Trip"]:::action
    EMP --> EMP_VIEW["View Own Requests<br/>✅ All Request History"]:::module
    EMP --> EMP_REPORT["✅ Personal Reports"]:::module
    
    %% Legend
    subgraph LEGEND["📋 Legend"]
        direction LR
        L1["Super Admin"]:::superadmin
        L2["HR"]:::hr
        L3["Manager"]:::manager
        L4["Employee"]:::employee
        L5["Dashboard"]:::dashboard
        L6["Module"]:::module
        L7["Action"]:::action
    end
```
