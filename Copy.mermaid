---
config:
  theme: base
  themeVariables:
    background: '#f6f7fb'
    primaryColor: '#0f172a'
    primaryTextColor: '#ffffff'
    primaryBorderColor: '#020617'
    lineColor: '#475569'
  flowchart:
    nodeSpacing: 78
    rankSpacing: 120
    curve: linear
---

flowchart LR
    %% Chen-like ERD with fuller attributes for main entities

    classDef entity fill:#0f172a,color:#ffffff,stroke:#020617,stroke-width:2.5px
    classDef relation fill:#ffedd5,color:#7c2d12,stroke:#f97316,stroke-width:2.5px
    classDef attr fill:#ffffff,color:#0f172a,stroke:#64748b,stroke-width:1.6px

    %% ========== ENTITIES ==========
    W[workers]
    U[users]
    D[departments]
    S[shifts]
    WS[worker_shifts]
    L[locations]
    A[attendances]
    LR[leave_requests]
    OR[overtime_requests]
    BT[business_trips]
    WD[worker_documents]
    SSR[shift_swap_requests]

    %% ========== RELATIONSHIPS ==========
    R_ACCOUNT{account}
    R_WORKS_IN{works_in}
    R_ASSIGNED_SHIFT{assigned_shift}
    R_RECORDS{records}
    R_IN_SHIFT{in_shift}
    R_AT_LOCATION{at_location}
    R_REQ_LEAVE{requests_leave}
    R_REQ_OT{requests_overtime}
    R_REQ_TRIP{requests_trip}
    R_OWNS_DOC{owns_document}
    R_REQ_SWAP{requests_swap}
    R_REF_SHIFT{references_shift}

    W -- "1" --- R_ACCOUNT
    R_ACCOUNT -- "1" --- U

    W -- "N" --- R_WORKS_IN
    R_WORKS_IN -- "1" --- D

    W -- "1" --- R_ASSIGNED_SHIFT
    R_ASSIGNED_SHIFT -- "N" --- WS
    S -- "1" --- WS

    W -- "1" --- R_RECORDS
    R_RECORDS -- "N" --- A

    S -- "1" --- R_IN_SHIFT
    R_IN_SHIFT -- "N" --- A

    L -- "1" --- R_AT_LOCATION
    R_AT_LOCATION -- "N" --- A

    W -- "1" --- R_REQ_LEAVE
    R_REQ_LEAVE -- "N" --- LR

    W -- "1" --- R_REQ_OT
    R_REQ_OT -- "N" --- OR

    W -- "1" --- R_REQ_TRIP
    R_REQ_TRIP -- "N" --- BT

    W -- "1" --- R_OWNS_DOC
    R_OWNS_DOC -- "N" --- WD

    W -- "1" --- R_REQ_SWAP
    R_REQ_SWAP -- "N" --- SSR

    WS -- "1" --- R_REF_SHIFT
    R_REF_SHIFT -- "N" --- SSR

    %% ========== ATTRIBUTES: workers ==========
    W_ID([id PK]) --- W
    W_NIP([nip UK]) --- W
    W_NAME([name]) --- W
    W_EMAIL([email UK]) --- W
    W_PHONE([phone_number UK]) --- W
    W_ADDRESS([address]) --- W
    W_BIRTH_DATE([birth_date]) --- W
    W_BIRTH_PLACE([birth_place]) --- W
    W_GENDER([gender_id FK]) --- W
    W_RELIGION([religion_id FK]) --- W
    W_DEPT([department_id FK]) --- W
    W_HIRE([hire_date]) --- W
    W_RESIGN([resign_date]) --- W
    W_EMP([employment_status]) --- W
    W_STATUS([status]) --- W
    W_PHOTO([photo_url]) --- W
    W_DELETED([deleted_at]) --- W

    %% ========== ATTRIBUTES: users ==========
    U_ID([id PK]) --- U
    U_WORKER([worker_id FK]) --- U
    U_EMAIL([email UK]) --- U
    U_USERNAME([username UK]) --- U
    U_PASSWORD([password]) --- U
    U_LAST_LOGIN([last_login]) --- U
    U_ACTIVE([is_active]) --- U
    U_DELETED([deleted_at]) --- U

    %% ========== ATTRIBUTES: departments ==========
    D_ID([id PK]) --- D
    D_NAME([name]) --- D
    D_CODE([code UK]) --- D
    D_DESC([description]) --- D
    D_PARENT([parent_id FK]) --- D
    D_MANAGER([manager_id FK]) --- D
    D_REQ_HOLIDAY([requires_holiday_attendance]) --- D
    D_ACTIVE([is_active]) --- D

    %% ========== ATTRIBUTES: shifts ==========
    S_ID([id PK]) --- S
    S_NAME([name]) --- S
    S_START([start_time]) --- S
    S_END([end_time]) --- S
    S_TOTAL([total_hours]) --- S
    S_GRACE([grace_period_minutes]) --- S
    S_OVERNIGHT([is_overnight]) --- S
    S_ACTIVE([is_active]) --- S

    %% ========== ATTRIBUTES: worker_shifts ==========
    WS_ID([id PK]) --- WS
    WS_WORKER([worker_id FK]) --- WS
    WS_SHIFT([shift_id FK]) --- WS
    WS_FROM([effective_from]) --- WS
    WS_UNTIL([effective_until]) --- WS
    WS_ACTIVE([is_active]) --- WS
    WS_NOTES([notes]) --- WS

    %% ========== ATTRIBUTES: locations ==========
    L_ID([id PK]) --- L
    L_NAME([name]) --- L
    L_ADDRESS([address]) --- L
    L_LAT([latitude]) --- L
    L_LNG([longitude]) --- L
    L_RADIUS([radius]) --- L
    L_ENFORCE([enforce_geofence]) --- L
    L_ACTIVE([is_active]) --- L

    %% ========== ATTRIBUTES: attendances ==========
    A_ID([id PK]) --- A
    A_WORKER([worker_id FK]) --- A
    A_SHIFT([shift_id FK]) --- A
    A_LOCATION([location_id FK]) --- A
    A_DATE([attendance_date]) --- A
    A_IN([check_in]) --- A
    A_IN_LAT([check_in_latitude]) --- A
    A_IN_LNG([check_in_longitude]) --- A
    A_IN_DIST([distance_check_in]) --- A
    A_IN_BY_ADMIN([check_in_by_admin]) --- A
    A_IN_ADMIN([check_in_admin_id FK]) --- A
    A_OUT([check_out]) --- A
    A_OUT_LAT([check_out_latitude]) --- A
    A_OUT_LNG([check_out_longitude]) --- A
    A_OUT_DIST([distance_check_out]) --- A
    A_OUT_BY_ADMIN([check_out_by_admin]) --- A
    A_OUT_ADMIN([check_out_admin_id FK]) --- A
    A_STATUS([status]) --- A
    A_LATE([is_late]) --- A
    A_LATE_MIN([late_minutes]) --- A
    A_EARLY([is_early_leave]) --- A
    A_EARLY_MIN([early_leave_minutes]) --- A
    A_OUTSIDE([is_outside_radius]) --- A
    A_OT_MIN([overtime_minutes]) --- A
    A_NOTES([notes]) --- A
    A_DELETED([deleted_at]) --- A

    %% ========== ATTRIBUTES: leave_requests ==========
    LR_ID([id PK]) --- LR
    LR_WORKER([worker_id FK]) --- LR
    LR_TYPE([leave_type_id FK]) --- LR
    LR_START([start_date]) --- LR
    LR_END([end_date]) --- LR
    LR_TOTAL([total_days]) --- LR
    LR_REASON([reason]) --- LR
    LR_ATTACHMENT([attachment_path]) --- LR
    LR_STATUS([status]) --- LR
    LR_APPROVER([approved_by FK]) --- LR
    LR_APPROVED_AT([approved_at]) --- LR
    LR_REJECT([rejection_reason]) --- LR
    LR_DELETED([deleted_at]) --- LR

    %% ========== ATTRIBUTES: overtime_requests ==========
    OR_ID([id PK]) --- OR
    OR_WORKER([worker_id FK]) --- OR
    OR_DATE([overtime_date]) --- OR
    OR_START([start_time]) --- OR
    OR_END([end_time]) --- OR
    OR_TOTAL([total_hours]) --- OR
    OR_REASON([reason]) --- OR
    OR_STATUS([status]) --- OR
    OR_APPROVER([approved_by FK]) --- OR
    OR_APPROVED_AT([approved_at]) --- OR
    OR_REJECT([rejection_reason]) --- OR
    OR_DELETED([deleted_at]) --- OR

    %% ========== ATTRIBUTES: business_trips ==========
    BT_ID([id PK]) --- BT
    BT_WORKER([worker_id FK]) --- BT
    BT_DEST([destination]) --- BT
    BT_PURPOSE([purpose]) --- BT
    BT_START([start_date]) --- BT
    BT_END([end_date]) --- BT
    BT_COST([estimated_cost]) --- BT
    BT_STATUS([status]) --- BT
    BT_APPROVER([approved_by FK]) --- BT
    BT_APPROVED_AT([approved_at]) --- BT
    BT_REJECT([rejection_reason]) --- BT
    BT_ITINERARY([itinerary]) --- BT
    BT_DELETED([deleted_at]) --- BT

    %% ========== ATTRIBUTES: worker_documents ==========
    WD_ID([id PK]) --- WD
    WD_WORKER([worker_id FK]) --- WD
    WD_TYPE([document_type_id FK]) --- WD
    WD_DEPT_TYPE([department_document_type_id FK]) --- WD
    WD_NAME([file_name]) --- WD
    WD_PATH([file_path]) --- WD
    WD_SIZE([file_size]) --- WD
    WD_EXPIRE([expired_date]) --- WD
    WD_STATUS([status]) --- WD
    WD_VERIFIER([verified_by FK]) --- WD
    WD_VERIFIED_AT([verified_at]) --- WD
    WD_NOTES([notes]) --- WD
    WD_DELETED([deleted_at]) --- WD

    %% ========== ATTRIBUTES: shift_swap_requests ==========
    SSR_ID([id PK]) --- SSR
    SSR_REQUESTER([requester_id FK]) --- SSR
    SSR_TARGET([target_worker_id FK]) --- SSR
    SSR_REQ_SHIFT([requester_shift_id FK]) --- SSR
    SSR_TARGET_SHIFT([target_shift_id FK]) --- SSR
    SSR_SWAP_TYPE([swap_type]) --- SSR
    SSR_SWAP_DATE([swap_date]) --- SSR
    SSR_SWAP_START([swap_start_date]) --- SSR
    SSR_SWAP_END([swap_end_date]) --- SSR
    SSR_SWAP_DATES([swap_dates]) --- SSR
    SSR_STATUS([status]) --- SSR
    SSR_REQ_MANAGER([requires_manager_approval]) --- SSR
    SSR_MANAGER([manager_id FK]) --- SSR
    SSR_MANAGER_AT([manager_approved_at]) --- SSR
    SSR_REASON([reason]) --- SSR
    SSR_META([metadata]) --- SSR
    SSR_EXECUTOR([executed_by FK]) --- SSR
    SSR_REQUESTED_AT([requested_at]) --- SSR
    SSR_EXPIRES([expires_at]) --- SSR
    SSR_EXECUTED([executed_at]) --- SSR
    SSR_DELETED([deleted_at]) --- SSR

    %% ========== CLASS MAP ==========
    class W,U,D,S,WS,L,A,LR,OR,BT,WD,SSR entity
    class R_ACCOUNT,R_WORKS_IN,R_ASSIGNED_SHIFT,R_RECORDS,R_IN_SHIFT,R_AT_LOCATION,R_REQ_LEAVE,R_REQ_OT,R_REQ_TRIP,R_OWNS_DOC,R_REQ_SWAP,R_REF_SHIFT relation
    class W_ID,W_NIP,W_NAME,W_EMAIL,W_PHONE,W_ADDRESS,W_BIRTH_DATE,W_BIRTH_PLACE,W_GENDER,W_RELIGION,W_DEPT,W_HIRE,W_RESIGN,W_EMP,W_STATUS,W_PHOTO,W_DELETED,U_ID,U_WORKER,U_EMAIL,U_USERNAME,U_PASSWORD,U_LAST_LOGIN,U_ACTIVE,U_DELETED,D_ID,D_NAME,D_CODE,D_DESC,D_PARENT,D_MANAGER,D_REQ_HOLIDAY,D_ACTIVE,S_ID,S_NAME,S_START,S_END,S_TOTAL,S_GRACE,S_OVERNIGHT,S_ACTIVE,WS_ID,WS_WORKER,WS_SHIFT,WS_FROM,WS_UNTIL,WS_ACTIVE,WS_NOTES,L_ID,L_NAME,L_ADDRESS,L_LAT,L_LNG,L_RADIUS,L_ENFORCE,L_ACTIVE,A_ID,A_WORKER,A_SHIFT,A_LOCATION,A_DATE,A_IN,A_IN_LAT,A_IN_LNG,A_IN_DIST,A_IN_BY_ADMIN,A_IN_ADMIN,A_OUT,A_OUT_LAT,A_OUT_LNG,A_OUT_DIST,A_OUT_BY_ADMIN,A_OUT_ADMIN,A_STATUS,A_LATE,A_LATE_MIN,A_EARLY,A_EARLY_MIN,A_OUTSIDE,A_OT_MIN,A_NOTES,A_DELETED,LR_ID,LR_WORKER,LR_TYPE,LR_START,LR_END,LR_TOTAL,LR_REASON,LR_ATTACHMENT,LR_STATUS,LR_APPROVER,LR_APPROVED_AT,LR_REJECT,LR_DELETED,OR_ID,OR_WORKER,OR_DATE,OR_START,OR_END,OR_TOTAL,OR_REASON,OR_STATUS,OR_APPROVER,OR_APPROVED_AT,OR_REJECT,OR_DELETED,BT_ID,BT_WORKER,BT_DEST,BT_PURPOSE,BT_START,BT_END,BT_COST,BT_STATUS,BT_APPROVER,BT_APPROVED_AT,BT_REJECT,BT_ITINERARY,BT_DELETED,WD_ID,WD_WORKER,WD_TYPE,WD_DEPT_TYPE,WD_NAME,WD_PATH,WD_SIZE,WD_EXPIRE,WD_STATUS,WD_VERIFIER,WD_VERIFIED_AT,WD_NOTES,WD_DELETED,SSR_ID,SSR_REQUESTER,SSR_TARGET,SSR_REQ_SHIFT,SSR_TARGET_SHIFT,SSR_SWAP_TYPE,SSR_SWAP_DATE,SSR_SWAP_START,SSR_SWAP_END,SSR_SWAP_DATES,SSR_STATUS,SSR_REQ_MANAGER,SSR_MANAGER,SSR_MANAGER_AT,SSR_REASON,SSR_META,SSR_EXECUTOR,SSR_REQUESTED_AT,SSR_EXPIRES,SSR_EXECUTED,SSR_DELETED attr

    linkStyle default stroke:#64748b,stroke-width:1.6px
